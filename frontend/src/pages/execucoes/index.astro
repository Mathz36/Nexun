---
import MainLayout from '../../layouts/MainLayout.astro';
---

<MainLayout title="Execuções" active="execucoes">
  <div class="mb-6">
    <p class="font-mono text-xs text-blue-600">// execution log</p>
    <p class="mt-1 text-sm text-slate-500">Rastreabilidade das automações e consultas executadas.</p>
  </div>
  <div class="data-panel">
    <table class="min-w-full divide-y divide-slate-200 text-sm">
      <thead class="bg-slate-50/80 text-left text-[11px] font-semibold uppercase tracking-wide text-slate-500">
        <tr>
          <th class="px-4 py-3">Data/Hora</th>
          <th class="px-4 py-3">Relatório</th>
          <th class="px-4 py-3">Status</th>
          <th class="px-4 py-3">Tempo</th>
          <th class="px-4 py-3">Registros</th>
          <th class="px-4 py-3">Erro</th>
        </tr>
      </thead>
      <tbody id="executions-tbody">
        <tr><td colspan="6" class="px-4 py-8 text-center text-sm text-slate-500">Carregando…</td></tr>
      </tbody>
    </table>
  </div>
</MainLayout>

<script>
  import { api } from '../../services/api';

  function statusBadge(status: string) {
    const map: Record<string, string> = {
      SUCCESS: 'bg-emerald-100 text-emerald-700',
      ERROR: 'bg-red-100 text-red-700',
      RUNNING: 'bg-blue-100 text-blue-700',
    };
    const labels: Record<string, string> = { SUCCESS: '✓ Sucesso', ERROR: '✕ Erro', RUNNING: '… Executando' };
    return `<span class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold ${map[status] ?? ''}">${labels[status] ?? status}</span>`;
  }

  async function load() {
    const tbody = document.getElementById('executions-tbody')!;
    try {
      const reports = await api.reports.list();
      const reportNameById = new Map(reports.map((r) => [r.id, r.nome]));
      const executions = (await api.executions.list()) as any[];

      if (executions.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" class="px-4 py-8 text-center text-sm text-slate-500">Nenhuma execução registrada ainda.</td></tr>`;
        return;
      }

      tbody.innerHTML = executions
        .map(
          (e) => `
        <tr class="hover:bg-slate-50">
          <td class="px-4 py-3">${new Date(e.dataHora).toLocaleString('pt-BR')}</td>
          <td class="px-4 py-3 font-medium">${reportNameById.get(e.reportId) ?? e.reportId}</td>
          <td class="px-4 py-3">${statusBadge(e.status)}</td>
          <td class="px-4 py-3">${e.tempoExecucao !== null ? `${e.tempoExecucao} ms` : '—'}</td>
          <td class="px-4 py-3">${e.quantidadeRegistros ?? '—'}</td>
          <td class="px-4 py-3 text-xs text-red-600">${e.erro ?? ''}</td>
        </tr>`,
        )
        .join('');
    } catch (err) {
      tbody.innerHTML = `<tr><td colspan="6" class="px-4 py-8 text-center text-sm text-red-600">Erro: ${(err as Error).message}</td></tr>`;
    }
  }

  load();
</script>
