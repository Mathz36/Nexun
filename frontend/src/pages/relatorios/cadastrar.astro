---
import MainLayout from '../../layouts/MainLayout.astro';
---

<MainLayout title="Cadastrar Relatório" active="relatorios">
  <div class="mx-auto max-w-5xl space-y-6">
    <div>
      <p class="font-mono text-xs text-blue-600">// automation definition</p>
      <p class="mt-1 text-sm text-slate-500">Defina a consulta, valide o retorno e publique o fluxo.</p>
    </div>
    <form id="report-form" class="data-panel space-y-5 p-6">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label class="mb-1 block text-sm font-medium text-slate-700">Nome</label>
          <input
            name="nome"
            required
            placeholder="Ex: Envu - Venda"
            class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none"
          />
        </div>
        <div>
          <label class="mb-1 block text-sm font-medium text-slate-700">Fornecedor</label>
          <input
            name="fornecedor"
            required
            placeholder="Ex: ENVU"
            class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none"
          />
        </div>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label class="mb-1 block text-sm font-medium text-slate-700">Tipo</label>
          <select
            name="tipo"
            class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none"
          >
            <option value="Venda">Venda</option>
            <option value="EDI">EDI</option>
            <option value="Outro">Outro</option>
          </select>
        </div>
        <div class="flex items-end pb-2">
          <label class="flex items-center gap-2 text-sm text-slate-700">
            <input type="checkbox" name="ativo" checked class="rounded border-slate-300" />
            Relatório ativo
          </label>
        </div>
      </div>

      <div>
        <label class="mb-1 block text-sm font-medium text-slate-700">Descrição</label>
        <textarea
          name="descricao"
          rows="2"
          class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none"
        ></textarea>
      </div>

      <div>
        <div class="mb-1 flex items-center justify-between">
          <label class="font-mono text-xs font-semibold uppercase tracking-wide text-slate-500">Query / fonte de dados</label>
          <span class="text-xs text-slate-400">
            Deve retornar: FORNECEDOR, OPERACAO, NF, VLR_LIQUIDO e QUANTIDADE. VLR_BRUTO é opcional.
          </span>
        </div>
        <textarea
          name="query"
          required
          rows="10"
          spellcheck="false"
          placeholder="select ..."
          class="ide-surface min-h-64 w-full px-4 py-3 font-mono text-sm leading-6 text-emerald-300 outline-none focus:border-blue-400"
        ></textarea>
      </div>

      <div id="test-result"></div>

      <div class="flex items-center justify-between border-t border-slate-100 pt-4">
        <button
          type="button"
          id="btn-test"
          class="command-button rounded-md border border-slate-300 bg-white px-4 py-2 text-slate-700 hover:border-blue-300 hover:text-blue-700"
        >
          Testar Query
        </button>
        <div class="flex gap-2">
            <a href="/relatorios" class="command-button rounded-md px-4 py-2 text-slate-600 hover:bg-slate-100">
            Cancelar
          </a>
          <button
            type="submit"
            id="btn-save"
            disabled
            class="command-button rounded-md bg-blue-600 px-4 py-2 text-white hover:bg-blue-700 disabled:cursor-not-allowed disabled:opacity-50"
          >
            Salvar relatório
          </button>
        </div>
      </div>
      <p class="text-xs text-slate-400">
        O botão "Salvar" só é liberado depois que a query passar no teste de colunas obrigatórias.
      </p>
    </form>
  </div>
</MainLayout>

<script>
  import { api } from '../../services/api';

  function toast(message: string, type: 'success' | 'error' = 'success') {
    window.dispatchEvent(new CustomEvent('toast', { detail: { message, type } }));
  }

  const form = document.getElementById('report-form') as HTMLFormElement;
  const btnSave = document.getElementById('btn-save') as HTMLButtonElement;
  const resultBox = document.getElementById('test-result')!;
  const editingReportId = new URLSearchParams(window.location.search).get('id');
  const queryField = form.elements.namedItem('query') as HTMLTextAreaElement;

  if (editingReportId) {
    document.title = 'Editar Relatório';
    btnSave.textContent = 'Atualizar relatório';

    api.reports.getById(editingReportId).then((report) => {
      (form.elements.namedItem('nome') as HTMLInputElement).value = report.nome;
      (form.elements.namedItem('fornecedor') as HTMLInputElement).value = report.fornecedor;
      (form.elements.namedItem('tipo') as HTMLSelectElement).value = report.tipo;
      (form.elements.namedItem('descricao') as HTMLTextAreaElement).value = report.descricao ?? '';
      queryField.value = report.query;
      (form.elements.namedItem('ativo') as HTMLInputElement).checked = report.ativo;
    }).catch((err) => {
      toast((err as Error).message, 'error');
    });
  }

  document.getElementById('btn-test')!.addEventListener('click', async () => {
    const query = queryField.value.trim();
    if (!query) {
      toast('Informe uma query antes de testar.', 'error');
      return;
    }

    resultBox.innerHTML = `<p class="text-sm text-slate-500">Executando no DbExplorer…</p>`;
    btnSave.disabled = true;

    try {
      const preview = await api.reports.testQuery(query);

      if (!preview.valid) {
        resultBox.innerHTML = `
          <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700">
            <p class="font-medium">A query não possui a(s) coluna(s) obrigatória(s):</p>
            <ul class="mt-1 list-disc pl-5">
              ${preview.missingColumns.map((c) => `<li>${c}</li>`).join('')}
            </ul>
          </div>`;
        return;
      }

      resultBox.innerHTML = `
        <div class="rounded-lg border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-800">
          <p class="font-medium">✓ Query válida — ${preview.totalRows} registro(s) encontrados.</p>
          <p class="mt-1 text-xs text-emerald-700">Prévia dos primeiros registros normalizados abaixo.</p>
        </div>
        <div class="mt-3 overflow-x-auto rounded-lg border border-slate-200">
          <table class="min-w-full divide-y divide-slate-200 text-xs">
            <thead class="bg-slate-50 text-left font-semibold uppercase text-slate-500">
              <tr>
                <th class="px-3 py-2">Fornecedor</th>
                <th class="px-3 py-2">Operação</th>
                <th class="px-3 py-2">NF</th>
                <th class="px-3 py-2">Vlr Líquido</th>
                <th class="px-3 py-2">Vlr Bruto</th>
                <th class="px-3 py-2">Qtd</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              ${preview.sampleRows
                .map(
                  (r: any) => `
                <tr>
                  <td class="px-3 py-2">${r.fornecedor}</td>
                  <td class="px-3 py-2">${r.operacao}</td>
                  <td class="px-3 py-2">${r.nf}</td>
                  <td class="px-3 py-2">${r.valorLiquido}</td>
                  <td class="px-3 py-2">${r.valorBruto}</td>
                  <td class="px-3 py-2">${r.quantidade}</td>
                </tr>`,
                )
                .join('')}
            </tbody>
          </table>
        </div>`;

      btnSave.disabled = false;
    } catch (err) {
      resultBox.innerHTML = `<div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700">${(err as Error).message}</div>`;
    }
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);

    try {
      const input = {
        nome: String(formData.get('nome')),
        fornecedor: String(formData.get('fornecedor')),
        tipo: String(formData.get('tipo')),
        descricao: String(formData.get('descricao') || '') || null,
        query: String(formData.get('query')),
        ativo: formData.get('ativo') === 'on',
      } as any;

      if (editingReportId) {
        await api.reports.update(editingReportId, input);
        toast('Relatório atualizado com sucesso.');
      } else {
        await api.reports.create(input);
        toast('Relatório cadastrado com sucesso.');
      }
      window.location.href = '/relatorios';
    } catch (err) {
      toast((err as Error).message, 'error');
    }
  });

  // Reseta a validação sempre que a query for editada após um teste bem-sucedido,
  // para forçar um novo teste antes de salvar (a query pode ter mudado).
  queryField.addEventListener('input', () => {
    btnSave.disabled = true;
  });
</script>
