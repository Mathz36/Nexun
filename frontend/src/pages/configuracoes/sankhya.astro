---
import MainLayout from '../../layouts/MainLayout.astro';
---

<MainLayout title="Configurações" active="config">
  <div class="mx-auto w-full max-w-3xl space-y-6">
    <div class="mb-1">
      <p class="font-mono text-xs text-blue-600">// workspace settings</p>
      <p class="mt-1 text-sm text-slate-500">Conexões, agenda e notificações da operação.</p>
    </div>
    <div class="data-panel p-6">
      <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">
        Status da Integração
      </h2>
      <dl class="space-y-3 text-sm">
        <div class="flex items-center justify-between">
          <dt class="text-slate-600">API do ERP</dt>
          <dd class="font-medium text-emerald-700">✓ Configurada</dd>
        </div>
        <div class="flex items-center justify-between">
          <dt class="text-slate-600">DbExplorer</dt>
          <dd class="font-medium text-emerald-700">✓ Configurado</dd>
        </div>
        <div class="flex items-center justify-between">
          <dt class="text-slate-600">Autenticação</dt>
          <dd id="auth-status" class="font-medium text-slate-400">— não testada</dd>
        </div>
        <div class="flex items-center justify-between border-t border-slate-100 pt-3">
          <dt class="text-slate-500 text-xs">Última verificação</dt>
          <dd id="last-check" class="text-xs text-slate-500">—</dd>
        </div>
      </dl>

      <button
        id="btn-test-connection"
        class="mt-5 w-full rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700"
      >
        Testar conexão
      </button>

      <p class="mt-3 text-xs text-slate-400">
        As credenciais (CLIENT_ID, CLIENT_SECRET, X-Token) ficam exclusivamente no backend
        e nunca são exibidas nesta tela.
      </p>
    </div>

    <div class="data-panel p-6">
      <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-slate-500">
        Alertas por e-mail
      </h2>
      <p class="mb-4 text-sm text-slate-600">
        Envia automaticamente um resumo das divergências encontradas após cada sincronização.
      </p>
      <div class="space-y-4 text-sm">
        <label class="flex items-center gap-2 text-slate-700">
          <input id="email-alert-enabled" type="checkbox" class="rounded border-slate-300" />
          Ativar alertas
        </label>
        <label class="block text-slate-700">
          Tipo de aviso
          <select id="email-alert-type" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2">
            <option value="DIVERGENCIA">Divergência</option>
            <option value="TODOS">Todos</option>
          </select>
        </label>
        <div class="grid gap-3 md:grid-cols-2">
          <label class="block text-slate-700">
            E-mail de envio
            <input id="email-sender" type="email" placeholder="sistema@empresa.com" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" />
          </label>
          <label class="block text-slate-700">
            E-mail de recebimento
            <input id="email-recipient" type="email" placeholder="gestor@empresa.com" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" />
          </label>
        </div>
        <label class="block text-slate-700">
          Senha do e-mail de envio
          <input id="email-password" type="password" autocomplete="new-password" placeholder="Preencha para cadastrar ou alterar" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" />
          <span id="email-password-status" class="mt-1 block text-xs text-slate-400"></span>
        </label>
        <div class="flex gap-2">
          <button id="btn-save-email" class="flex-1 rounded-lg bg-brand-600 px-4 py-2 font-medium text-white hover:bg-brand-700">
            Salvar alerta
          </button>
          <button id="btn-test-email" class="flex-1 rounded-lg border border-slate-300 px-4 py-2 font-medium text-slate-700 hover:bg-slate-50">
            Testar SMTP
          </button>
        </div>
        <button id="btn-send-email" class="w-full rounded-lg border border-amber-300 bg-amber-50 px-4 py-2 font-medium text-amber-800 hover:bg-amber-100">
          Enviar alerta agora
        </button>
        <p id="email-alert-status" class="text-xs text-slate-500">Carregando configuração…</p>
        <p class="text-xs text-slate-400">O servidor SMTP é configurado pelo backend nas variáveis SMTP_HOST, SMTP_PORT e SMTP_SECURE.</p>
      </div>
    </div>
  </div>
</MainLayout>

<script>
  import { api } from '../../services/api';

  const btn = document.getElementById('btn-test-connection') as HTMLButtonElement;
  const authStatus = document.getElementById('auth-status')!;
  const lastCheck = document.getElementById('last-check')!;
  const emailEnabled = document.getElementById('email-alert-enabled') as HTMLInputElement;
  const emailAlertType = document.getElementById('email-alert-type') as HTMLSelectElement;
  const emailSender = document.getElementById('email-sender') as HTMLInputElement;
  const emailRecipient = document.getElementById('email-recipient') as HTMLInputElement;
  const emailPassword = document.getElementById('email-password') as HTMLInputElement;
  const emailPasswordStatus = document.getElementById('email-password-status')!;
  const saveEmail = document.getElementById('btn-save-email') as HTMLButtonElement;
  const testEmail = document.getElementById('btn-test-email') as HTMLButtonElement;
  const sendEmail = document.getElementById('btn-send-email') as HTMLButtonElement;
  const emailStatus = document.getElementById('email-alert-status')!;

  function formatDate(value: string | null) {
    return value ? new Date(value).toLocaleString('pt-BR') : 'nunca';
  }

  function renderEmailSettings(settings: any) {
    emailEnabled.checked = settings.enabled;
    emailAlertType.value = settings.alertType ?? 'DIVERGENCIA';
    emailSender.value = settings.senderEmail;
    emailRecipient.value = settings.recipientEmail;
    emailPasswordStatus.textContent = settings.passwordConfigured
      ? 'Senha já configurada. Deixe vazio para mantê-la.'
      : 'Nenhuma senha configurada.';
    emailStatus.textContent = settings.lastError
      ? `Último erro: ${settings.lastError}`
      : settings.lastSentAt
        ? `Último alerta enviado: ${formatDate(settings.lastSentAt)}`
        : 'Nenhum alerta enviado ainda.';
  }

  api.emailAlert.get().then(renderEmailSettings).catch((err) => {
    emailStatus.textContent = `Erro ao carregar alerta: ${(err as Error).message}`;
  });

  saveEmail.addEventListener('click', async () => {
    saveEmail.disabled = true;
    try {
      const settings = await api.emailAlert.update({
        enabled: emailEnabled.checked,
        alertType: emailAlertType.value as 'DIVERGENCIA' | 'TODOS',
        senderEmail: emailSender.value.trim(),
        recipientEmail: emailRecipient.value.trim(),
        password: emailPassword.value || undefined,
      });
      emailPassword.value = '';
      renderEmailSettings(settings);
      window.dispatchEvent(new CustomEvent('toast', { detail: { message: 'Configuração de alerta salva.' } }));
    } catch (err) {
      window.dispatchEvent(new CustomEvent('toast', { detail: { message: (err as Error).message, type: 'error' } }));
    } finally {
      saveEmail.disabled = false;
    }
  });

  testEmail.addEventListener('click', async () => {
    testEmail.disabled = true;
    testEmail.textContent = 'Testando…';
    try {
      await api.emailAlert.test();
      window.dispatchEvent(new CustomEvent('toast', { detail: { message: 'Conexão SMTP funcionando.' } }));
    } catch (err) {
      window.dispatchEvent(new CustomEvent('toast', { detail: { message: (err as Error).message, type: 'error' } }));
    } finally {
      testEmail.disabled = false;
      testEmail.textContent = 'Testar SMTP';
    }
  });

  sendEmail.addEventListener('click', async () => {
    sendEmail.disabled = true;
    sendEmail.textContent = 'Enviando…';
    try {
      const result = await api.emailAlert.sendNow();
      window.dispatchEvent(new CustomEvent('toast', {
        detail: {
          message: result.sent
            ? 'Alerta enviado com os dados atuais.'
            : 'Nenhuma divergência encontrada ou alerta desativado.',
          type: result.sent ? 'success' : 'error',
        },
      }));
      const settings = await api.emailAlert.get();
      renderEmailSettings(settings);
    } catch (err) {
      window.dispatchEvent(new CustomEvent('toast', { detail: { message: (err as Error).message, type: 'error' } }));
    } finally {
      sendEmail.disabled = false;
      sendEmail.textContent = 'Enviar alerta agora';
    }
  });

  btn.addEventListener('click', async () => {
    btn.disabled = true;
    btn.textContent = 'Testando…';
    authStatus.textContent = '— testando';
    authStatus.className = 'font-medium text-slate-400';

    try {
      const result = await api.health.sankhya();
      if (result.ok) {
        authStatus.textContent = '✓ Funcionando';
        authStatus.className = 'font-medium text-emerald-700';
      } else {
        authStatus.textContent = '✕ Falha na autenticação do ERP';
        authStatus.className = 'font-medium text-red-700';
      }
    } catch (err) {
      authStatus.textContent = '✕ Falha na autenticação do ERP';
      authStatus.className = 'font-medium text-red-700';
    } finally {
      lastCheck.textContent = new Date().toLocaleString('pt-BR');
      btn.disabled = false;
      btn.textContent = 'Testar conexão';
    }
  });
</script>
