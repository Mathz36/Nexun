---
import '../styles/global.css';

interface Props {
  title: string;
  active?: string;
}

const { title, active = '' } = Astro.props;

const menu = [
  { label: 'Visão geral', href: '/', key: 'dashboard', icon: '▦' },
  { label: 'Automações', href: '/relatorios', key: 'relatorios', icon: '◇' },
  { label: 'Comparar dados', href: '/relatorios/cruzar', key: 'cruzar', icon: '⇄' },
  { label: 'Histórico', href: '/execucoes', key: 'execucoes', icon: '◷' },
  { label: 'Configurações', href: '/configuracoes/sankhya', key: 'config', icon: '⚙' },
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/nexun-icon.svg" />
    <meta name="theme-color" content="#0b0a16" />
    <title>{title} · Nexun</title>
  </head>
  <body class="min-h-screen flex">
    <aside class="app-sidebar flex w-60 shrink-0 flex-col text-white">
      <div class="border-b border-white/10 px-5 py-5">
        <div class="flex items-center gap-3">
          <div class="brand-mark" aria-label="Kraken Nexun" title="Nexun">
            <svg viewBox="0 0 32 32" role="img" aria-hidden="true" shape-rendering="crispEdges">
              <rect x="9" y="4" width="14" height="3" fill="#c084fc" />
              <rect x="6" y="7" width="20" height="12" fill="#a855f7" />
              <rect x="9" y="5" width="14" height="15" fill="#a855f7" />
              <rect x="7" y="10" width="18" height="9" fill="#9333ea" />
              <rect x="10" y="12" width="4" height="4" fill="#160d2b" />
              <rect x="18" y="12" width="4" height="4" fill="#160d2b" />
              <rect x="11" y="13" width="2" height="2" fill="#f5d0fe" />
              <rect x="19" y="13" width="2" height="2" fill="#f5d0fe" />
              <rect x="5" y="18" width="4" height="4" fill="#7e22ce" />
              <rect x="23" y="18" width="4" height="4" fill="#7e22ce" />
              <rect x="3" y="21" width="5" height="3" fill="#a855f7" />
              <rect x="24" y="21" width="5" height="3" fill="#a855f7" />
              <rect x="7" y="20" width="4" height="7" fill="#7e22ce" />
              <rect x="21" y="20" width="4" height="7" fill="#7e22ce" />
              <rect x="10" y="20" width="3" height="9" fill="#9333ea" />
              <rect x="19" y="20" width="3" height="9" fill="#9333ea" />
              <rect x="14" y="20" width="4" height="8" fill="#c084fc" />
            </svg>
          </div>
          <div>
            <p class="text-sm font-semibold tracking-tight">Nexun</p>
            <p class="text-[11px] text-slate-400">automation workspace</p>
          </div>
        </div>
      </div>
      <div class="px-5 pt-6 text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-500">Workspace</div>
      <nav class="flex-1 space-y-1 px-3 py-3">
        {
          menu.map((item) => (
            <a
              href={item.href}
              class:list={[
                'group flex items-center gap-3 rounded-md border border-transparent px-3 py-2.5 text-sm transition-colors',
                active === item.key
                  ? 'border-white/10 bg-white/10 text-white'
                  : 'text-slate-400 hover:bg-white/5 hover:text-slate-100',
              ]}
            >
              <span class="w-5 text-center text-base text-slate-500 group-hover:text-blue-300">{item.icon}</span>
              <span>{item.label}</span>
            </a>
          ))
        }
      </nav>
      <div class="border-t border-white/10 px-5 py-4 text-[11px] text-slate-500">
        <span class="status-dot mr-1.5"></span> Serviços operacionais
      </div>
    </aside>

    <div class="flex-1 flex flex-col min-w-0">
      <header class="app-header flex h-16 shrink-0 items-center justify-between border-b px-7">
        <div>
          <p class="mb-0.5 text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-400">Nexun / workspace</p>
          <h1 class="text-lg font-semibold text-slate-900">{title}</h1>
        </div>
        <div class="flex items-center gap-3 text-xs text-slate-500">
          <span class="status-dot"></span>
          <span>Ambiente conectado</span>
        </div>
        <div id="toast-root" class="fixed top-4 right-4 z-50 flex flex-col gap-2"></div>
      </header>
      <main class="flex-1 overflow-y-auto px-7 py-6">
        <slot />
      </main>
    </div>
  </body>
</html>

<script>
  // Toast notifications simples, usado por qualquer página via
  // window.dispatchEvent(new CustomEvent('toast', { detail: { message, type } }))
  window.addEventListener('toast', (e: Event) => {
    const detail = (e as CustomEvent).detail as { message: string; type?: 'success' | 'error' };
    const root = document.getElementById('toast-root');
    if (!root) return;

    const el = document.createElement('div');
    const isError = detail.type === 'error';
    el.className = [
      'rounded-lg px-4 py-3 text-sm font-medium shadow-lg text-white transition-opacity',
      isError ? 'bg-red-600' : 'bg-emerald-600',
    ].join(' ');
    el.textContent = detail.message;
    root.appendChild(el);
    setTimeout(() => {
      el.classList.add('opacity-0');
      setTimeout(() => el.remove(), 300);
    }, 3500);
  });
</script>
