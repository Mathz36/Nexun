---
interface Props {
  status: 'OK' | 'DIVERGENCIA' | 'AUSENTE' | 'SEM_COMPARACAO' | 'SUCCESS' | 'ERROR' | 'RUNNING';
}

const { status } = Astro.props;

const styles: Record<string, string> = {
  OK: 'bg-emerald-100 text-emerald-700',
  SUCCESS: 'bg-emerald-100 text-emerald-700',
  DIVERGENCIA: 'bg-amber-100 text-amber-800',
  AUSENTE: 'bg-red-100 text-red-700',
  ERROR: 'bg-red-100 text-red-700',
  RUNNING: 'bg-blue-100 text-blue-700',
  SEM_COMPARACAO: 'bg-slate-100 text-slate-600',
};

const labels: Record<string, string> = {
  OK: '✓ OK',
  SUCCESS: '✓ Sucesso',
  DIVERGENCIA: '⚠ Divergência',
  AUSENTE: '✕ Ausente',
  ERROR: '✕ Erro',
  RUNNING: '… Executando',
  SEM_COMPARACAO: '— Sem comparação',
};
---

<span class={`inline-flex items-center rounded-full px-2.5 py-1 text-xs font-semibold ${styles[status] ?? 'bg-slate-100 text-slate-600'}`}>
  {labels[status] ?? status}
</span>
